<?xml version="1.0" encoding="utf-8"?>
<!-- 244dp total, inside the expanded custom notification's 252dp allowance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="244dp" android:orientation="vertical" android:padding="8dp" android:background="@drawable/notification_panel">
    <TextView android:id="@+id/notification_title" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:textSize="13sp" android:textColor="@color/notification_text" android:singleLine="true" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:background="@drawable/notification_card" android:baselineAligned="false">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="左耳" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/notification_text" />
            <TextView android:id="@+id/battery_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/notification_muted" />
            <ImageView android:layout_width="14dp" android:layout_height="7dp" android:src="@drawable/battery_status" android:tint="@color/notification_muted" android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="右耳" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/notification_text" />
            <TextView android:id="@+id/battery_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/notification_muted" />
            <ImageView android:layout_width="14dp" android:layout_height="7dp" android:src="@drawable/battery_status" android:tint="@color/notification_muted" android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="充电盒" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/notification_text" />
            <TextView android:id="@+id/battery_case" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/notification_muted" />
            <ImageView android:layout_width="14dp" android:layout_height="7dp" android:src="@drawable/battery_status" android:tint="@color/notification_muted" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:background="@drawable/notification_card" android:baselineAligned="false">

        <LinearLayout android:id="@+id/mode_anc" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_anc" android:layout_width="38dp" android:layout_height="38dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/label_anc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/notification_text" android:includeFontPadding="false" android:singleLine="true" android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout android:id="@+id/mode_wind" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_wind" android:layout_width="38dp" android:layout_height="38dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/label_wind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/notification_text" android:includeFontPadding="false" android:singleLine="true" android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout android:id="@+id/mode_transparency" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_transparency" android:layout_width="38dp" android:layout_height="38dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/label_transparency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/notification_text" android:includeFontPadding="false" android:singleLine="true" android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout android:id="@+id/mode_normal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/icon_normal" android:layout_width="38dp" android:layout_height="38dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/label_normal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/notification_text" android:includeFontPadding="false" android:singleLine="true" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/notification_anc_level" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/notification_card" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="降噪等级" android:textSize="12sp" android:textColor="@color/notification_text" />
        <TextView android:id="@+id/notification_anc_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/notification_muted" android:singleLine="true" />
    </LinearLayout>
    <TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:textSize="9sp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textColor="@color/notification_muted" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="2dp" android:orientation="horizontal">
        <TextView android:id="@+id/notification_more" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/notification_button" android:text="更多" android:textSize="12sp" android:textColor="@color/notification_text" android:clickable="true" android:focusable="true" android:contentDescription="打开 ZirconPods 完整控制界面" />
        <TextView android:id="@+id/notification_done" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:background="@drawable/notification_button" android:text="完成" android:textSize="12sp" android:textColor="@color/notification_text" android:clickable="true" android:focusable="true" android:contentDescription="结束本次通知交互，保持耳机连接" />
    </LinearLayout>
</LinearLayout>
